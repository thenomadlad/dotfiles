[Unit]
Description=Claude Code Remote Control (thenomadlad)
After=network.target network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
ExecStart=/usr/bin/zsh -ilc 'exec claude remote-control --name thenomadlad'
WorkingDirectory=/home/aditya/github.com/thenomadlad
Restart=on-failure
RestartSec=2
RestartSteps=5
RestartMaxDelaySec=60

[Install]
WantedBy=default.target
