[Unit]
Description=Claude Code Remote Control (retrofit-ui)
After=network.target network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
ExecStart=/usr/bin/zsh -ilc 'exec claude remote-control --name retrofit-ui'
WorkingDirectory=/home/aditya/github.com/retrofit-ui
Restart=on-failure
RestartSec=2
RestartSteps=5
RestartMaxDelaySec=60

[Install]
WantedBy=default.target
